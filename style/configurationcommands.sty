%%
%% configurationcommands.sty
%% Configuration commands of the HAW Kiel report template
%%
%% Author:  Yaacoub Harkat
%% Based on the thesis template of HAW Hamburg by Prof. Dr. Thomas Lehmann
%% and contributors (see README.md, section "Credits").
%%
%% Structure:
%%   1. Helper macros
%%   2. Text fields                \reportTitle{...}, \reportAuthor{...}, ...
%%   3. Switches (yes/no)          \NDA{yes}, \ListOfFigures{no}, ...
%%   4. Choices                    \reportKind{project}, \Cover{HAWKiel}, ...
%%   5. Page layout                \pageMargins{...}
%%   6. Resolving the configuration (runs automatically at \begin{document})
%%   7. Building blocks for report.tex   \ICoverPage, \IListOfFigures, ...
%%
%% Users do not need to change anything here. How to add report kinds,
%% study programmes or cover pages is described in README.md
%% ("Extending the template").
%%
%% Convention: all internal macros start with \I...
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{\@currpath configurationcommands}[2026/10/05 v1.1 Configuration of the HAW Kiel report template]

\RequirePackage{ifthen}
\RequirePackage{etoolbox}

%% ===========================================================================
%% 1. Helper macros
%% ===========================================================================

% Language switch: \IbyLang{German text}{English text}
\newif\ifIEnglish
\newcommand{\IbyLang}[2]{\ifIEnglish#2\else#1\fi}

% Error message for invalid values
\newcommand{\IConfigError}[2]{%
  \PackageError{configurationcommands}%
    {Invalid value '#2' for the command #1}%
    {See configuration/configuration.tex or README.md for the allowed values.}}

% Define a text field: \IdefineField{name}{default}
%   -> user command \name{...}, stored in \Iname
\newcommand{\IdefineField}[2]{%
  \expandafter\newcommand\csname I#1\endcsname{#2}%
  \expandafter\newcommand\csname #1\endcsname[1]{%
    \expandafter\renewcommand\csname I#1\endcsname{##1}}}

% Define a switch: \IdefineSwitch{Name}{yes|no}
%   -> user command \Name{yes|no}, query with \ifIName ... \fi
\newcommand{\IsetSwitch}[2]{%
  \ifthenelse{\equal{#2}{yes}}{\csname I#1true\endcsname}{%
    \ifthenelse{\equal{#2}{no}}{\csname I#1false\endcsname}{%
      \IConfigError{#1}{#2}}}}
\newcommand{\IdefineSwitch}[2]{%
  \expandafter\newif\csname ifI#1\endcsname
  \IsetSwitch{#1}{#2}%
  \expandafter\newcommand\csname #1\endcsname[1]{\IsetSwitch{#1}{##1}}}

% Title without manual line breaks (\\ -> space), e.g. for running text
\newcommand{\Iinline}[1]{%
  \begingroup\def\\{\unskip\space\ignorespaces}#1\endgroup}

