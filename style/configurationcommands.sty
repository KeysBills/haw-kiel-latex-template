%% ===========================================================================
%% 5. Page layout
%% ===========================================================================

% Exact page margins: \pageMargins{left}{right}{top}{bottom}
% Without this command the KOMA-Script type area (DIV/BCOR in report.tex) is
% used. Loads the geometry package, so it must be used in the preamble
% (i.e. in configuration.tex) and only once.
% Faculty of Media guideline: \pageMargins{3cm}{2cm}{2.5cm}{2.5cm}
\newcommand{\pageMargins}[4]{%
  \RequirePackage[left=#1,right=#2,top=#3,bottom=#4]{geometry}}

%% ===========================================================================
%% 6. Resolving the configuration
%%    Runs at the end of the preamble, so the order of the commands in
%%    configuration.tex does not matter.
%% ===========================================================================
\newif\ifIfound
\newif\ifIIsThesis

% resolved values
\newcommand{\IreportKindDE}{}
\newcommand{\IreportKindEN}{}
\newcommand{\IreportKindName}{}
\newcommand{\Icourse}{}
\newcommand{\Ifaculty}{}
\newcommand{\Iuniversity}{}
\newcommand{\IstudyCourseDisplay}{}
\newcommand{\IkeyWords}{}
\newcommand{\IBibStyle}{unsrtnat}

% \IkindCase{key}{German}{English}
\newcommand{\IkindCase}[3]{%
  \ifthenelse{\equal{\IreportKind}{#1}}{%
    \renewcommand{\IreportKindDE}{#2}\renewcommand{\IreportKindEN}{#3}\Ifoundtrue}{}}

\AtEndPreamble{%
  % --- Language -------------------------------------------------------------
  \ifthenelse{\equal{\IdocumentLanguage}{en}}{\IEnglishtrue}{%
    \ifthenelse{\equal{\IdocumentLanguage}{de}}{\IEnglishfalse}{%
      \IConfigError{documentLanguage}{\IdocumentLanguage}}}%
  %
  % --- Report kind ------------------------------------------------------------
  % New report kind? Add a line \IkindCase{...}{...}{...} here.
  \Ifoundfalse
  \IkindCase{project}{Projektbericht}{Project Report}%
  \IkindCase{seminar}{Seminararbeit}{Seminar Paper}%
  \IkindCase{term}{Hausarbeit}{Term Paper}%
  \IkindCase{lab}{Laborbericht}{Lab Report}%
  \IkindCase{internship}{Praktikumsbericht}{Internship Report}%
  \IkindCase{master}{Masterarbeit}{Master's Thesis}%
  \IkindCase{custom}{\IreportKindCustomDE}{\IreportKindCustomEN}%
  \ifIfound\else\IConfigError{reportKind}{\IreportKind}\fi
  \ifthenelse{\equal{\IreportKind}{master}}{\IIsThesistrue}{\IIsThesisfalse}%
  %
  % --- Study programme --------------------------------------------------------
  % New study programme? Add another \ifthenelse block here.
  \Ifoundfalse
  \ifthenelse{\equal{\Istudycourse}{DS}}{%
    \renewcommand{\IcourseDE}{Data Science}%
    \renewcommand{\IcourseEN}{Data Science}%
    \renewcommand{\IdegreeName}{Master of Science}%
    \renewcommand{\IdegreeShort}{M.Sc.}%
    \renewcommand{\IfacultyDE}{Fachbereich Medien}%
    \renewcommand{\IfacultyEN}{Faculty of Media}%
    \Ifoundtrue}{}%
  \ifthenelse{\equal{\Istudycourse}{custom}}{\Ifoundtrue}{}%
  \ifIfound\else\IConfigError{studycourse}{\Istudycourse}\fi
  %
  % --- Language-dependent values ----------------------------------------------
  \ifIEnglish
    \let\IreportKindName\IreportKindEN
    \let\Icourse\IcourseEN
    \let\Ifaculty\IfacultyEN
    \let\Iuniversity\IuniversityEN
    \let\IkeyWords\IkeywordsEN
  \else
    \let\IreportKindName\IreportKindDE
    \let\Icourse\IcourseDE
    \let\Ifaculty\IfacultyDE
    \let\Iuniversity\IuniversityDE
    \let\IkeyWords\IkeywordsDE
  \fi
  \renewcommand{\IstudyCourseDisplay}{%
    \Icourse\ifdefempty{\IdegreeShort}{}{ (\IdegreeShort)}}%
  %
  % --- Titles for the abstract page -------------------------------------------
  \ifdefempty{\IreportTitleDE}{\let\IreportTitleDE\IreportTitle}{}%
  \ifdefempty{\IreportTitleEN}{\let\IreportTitleEN\IreportTitle}{}%
  %
  % --- Supervisor labels ------------------------------------------------------
  \ifdefempty{\IfirstSupervisorLabel}{%
    \ifIIsThesis
      \renewcommand{\IfirstSupervisorLabel}{\IbyLang{Erstprüfer:in}{First examiner}}%
    \else
      \renewcommand{\IfirstSupervisorLabel}{\IbyLang{Betreuung}{Supervisor}}%
    \fi}{}%
  \ifdefempty{\IsecondSupervisorLabel}{%
    \ifIIsThesis
      \renewcommand{\IsecondSupervisorLabel}{\IbyLang{Zweitprüfer:in}{Second examiner}}%
    \else
      \renewcommand{\IsecondSupervisorLabel}{\IbyLang{Zweitbetreuung}{Second supervisor}}%
    \fi}{}%
  %
  % --- Accent colour ----------------------------------------------------------
  \edef\Itmp{\noexpand\definecolor{IAccent}{HTML}{\IaccentColor}}\Itmp
  %
  % --- Font style -------------------------------------------------------------
  \ifthenelse{\equal{\IfontStyle}{sans}}{%
    \renewcommand{\familydefault}{\sfdefault}}{%
    \ifthenelse{\equal{\IfontStyle}{serif}}{}{%
      \IConfigError{fontStyle}{\IfontStyle}}}%
  %
  % --- Line spacing -----------------------------------------------------------
  \ifthenelse{\equal{\IlineSpacing}{single}}{\singlespacing}{%
    \ifthenelse{\equal{\IlineSpacing}{onehalf}}{\onehalfspacing}{%
      \ifthenelse{\equal{\IlineSpacing}{double}}{\doublespacing}{%
        \IConfigError{lineSpacing}{\IlineSpacing}}}}%
  %
  % --- Citation style ---------------------------------------------------------
  \ifthenelse{\equal{\IcitationStyle}{numeric}}{%
    \setcitestyle{numbers,square}\renewcommand{\IBibStyle}{unsrtnat}}{%
    \ifthenelse{\equal{\IcitationStyle}{authoryear}}{%
      \setcitestyle{authoryear,round}\renewcommand{\IBibStyle}{plainnat}}{%
      \IConfigError{citationStyle}{\IcitationStyle}}}%
  %
  % --- Units ------------------------------------------------------------------
  \ifIEnglish\sisetup{locale=UK}\else\sisetup{locale=DE}\fi
  %
  % --- Check cover ------------------------------------------------------------
  % New cover page? Add its name here and in \ICoverPage (section 7).
  \ifthenelse{\equal{\ICover}{HAWKiel}\OR\equal{\ICover}{Leitfaden}%
      \OR\equal{\ICover}{Simple}\OR\equal{\ICover}{none}}{}{%
    \IConfigError{Cover}{\ICover}}%
}

\AtBeginDocument{%
  % Activate the language (hyphenation, "Contents"/"Inhaltsverzeichnis", ...)
  \ifIEnglish\selectlanguage{english}\else\selectlanguage{ngerman}\fi
  \normalfont   % make sure \fontStyle is applied
  %
  % Names for source code listings
  \renewcommand{\lstlistingname}{\IbyLang{Quellcode}{Listing}}%
  \renewcommand{\lstlistlistingname}{\IbyLang{Quellcodeverzeichnis}{List of Listings}}%
  \def\lstlistingautorefname{\lstlistingname}%   for \autoref{lst:...}
  %
  % PDF metadata
  \hypersetup{
    pdftitle={\IreportTitle},
    pdfauthor={\IreportAuthor},
    pdfsubject={\IreportKindName},
    pdfkeywords={\IkeyWords}
  }%
  %
  % Draft mode
  \ifIDraft
    \cfoot*{\footnotesize\color{gray}\IbyLang{Entwurf}{Draft} -- \today}%
  \else
    \renewcommand{\todo}[2][]{\@bsphack\@esphack}%
    \renewcommand{\listoftodos}[1][]{}%
    \renewcommand{\missingfigure}[2][]{}%
  \fi
}

%% ===========================================================================
%% 7. Building blocks for report.tex and the pages in style/pages/
%% ===========================================================================

% --- Logo (with placeholder if no file exists) --------------------------------
\newcommand{\ILogoPlaceholder}{%
  \PackageWarning{configurationcommands}{%
    Logo file \IlogoFile.pdf/.png/.jpg not found.\MessageBreak
    Using a placeholder. See style/logo/README.md}%
  \fcolorbox{IAccent}{white}{%
    \parbox[c][\IlogoHeight][c]{45mm}{\centering\sffamily\color{IAccent}%
      {\bfseries \IuniversityShort}\\[0.3ex]{\tiny Logo placeholder}}}}
\newcommand{\ILogo}{%
  \IfFileExists{\IlogoFile.pdf}{\includegraphics[height=\IlogoHeight,width=\linewidth,keepaspectratio]{\IlogoFile.pdf}}{%
  \IfFileExists{\IlogoFile.png}{\includegraphics[height=\IlogoHeight,width=\linewidth,keepaspectratio]{\IlogoFile.png}}{%
  \IfFileExists{\IlogoFile.jpg}{\includegraphics[height=\IlogoHeight,width=\linewidth,keepaspectratio]{\IlogoFile.jpg}}{%
  \ILogoPlaceholder}}}}

% --- Confidentiality notice ---------------------------------------------------
\newcommand{\INDAText}{\IbyLang{STRENG VERTRAULICH}{STRICTLY CONFIDENTIAL}}

% --- Info line "label  value" (omitted if the value is empty) -----------------
\newlength{\IinfoLabelWidth}
\setlength{\IinfoLabelWidth}{38mm}
\newcommand{\Iinfoline}[2]{%
  \ifdefempty{#2}{}{%
    \begingroup
    \setlength{\parfillskip}{0pt plus 1fil}% KOMA parskip adds 1em otherwise
    \noindent
    \parbox[t]{\IinfoLabelWidth}{\raggedright\bfseries #1}%
    \parbox[t]{\dimexpr\linewidth-\IinfoLabelWidth\relax}{\raggedright #2}\par
    \endgroup
    \smallskip}}

% Labels used on several pages
\newcommand{\ILabelSemesterOfStudy}{\IbyLang{Fachsemester}{Semester of study}}
\newcommand{\ILabelMatriculation}{\IbyLang{Matrikelnummer}{Student ID}}

% Block with all details (cover, title page)
\newcommand{\IInfoBlock}{%
  \Iinfoline{\IbyLang{Modul}{Module}}{\ImoduleName}%
  \Iinfoline{\IbyLang{Semester}{Term}}{\Isemester}%
  \Iinfoline{\IbyLang{Studiengang}{Degree programme}}{\IstudyCourseDisplay}%
  \Iinfoline{\ILabelSemesterOfStudy}{\IsemesterOfStudy}%
  \Iinfoline{\IbyLang{Kooperation}{In cooperation with}}{\IcooperationPartner}%
  \Iinfoline{\IfirstSupervisorLabel}{\IfirstSupervisor}%
  \Iinfoline{\IsecondSupervisorLabel}{\IsecondSupervisor}%
  \Iinfoline{\IbyLang{Abgabedatum}{Submission date}}{\IsubmissionDate}%
}

% Matriculation number and e-mail (below the name)
\newcommand{\IAuthorDetails}{%
  \ifdefempty{\ImatriculationNumber}{}{%
    \ILabelMatriculation: \ImatriculationNumber\par}%
  \ifdefempty{\IauthorEmail}{}{\href{mailto:\IauthorEmail}{\IauthorEmail}\par}}

% One block of the abstract page
% \IAbstractBlock{label title}{\title}{label keywords}{\keywords}{label text}{\text}
\newcommand{\IAbstractBlock}[6]{%
  \ifdefempty{#6}{}{%
    \textbf{\IreportAuthor}\par\smallskip
    \textbf{#1}\par
    \Iinline{#2}\par\smallskip
    \ifdefempty{#4}{}{\textbf{#3}\par #4\par\smallskip}%
    \textbf{#5}\par
    #6\par
    \vspace{1cm}}}

% --- Pages ------------------------------------------------------------------
% New cover page? Add a line here and its name in "Check cover" (section 6).
