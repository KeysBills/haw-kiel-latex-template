% Study programme data (filled by a preset or \studycourseCustom)
\newcommand{\IcourseDE}{}
\newcommand{\IcourseEN}{}
\newcommand{\IdegreeName}{}
\newcommand{\IdegreeShort}{}
\newcommand{\IfacultyDE}{}
\newcommand{\IfacultyEN}{}

% Custom study programme:
% \studycourseCustom{Programme DE}{Programme EN}{Degree}{Abbr.}{Faculty DE}{Faculty EN}
\newcommand{\studycourseCustom}[6]{%
