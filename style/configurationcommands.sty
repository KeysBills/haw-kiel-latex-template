  \ifthenelse{\equal{\ICover}{Leitfaden}}{\input{\StyleDir/pages/cover_leitfaden}}{}%
  \ifthenelse{\equal{\ICover}{Simple}}{\input{\StyleDir/pages/cover_simple}}{}}
\newcommand{\IFrontMatter}{\pagenumbering{roman}}
\newcommand{\ITitlePage}{\ifITitlePage\input{\StyleDir/pages/titlepage}\fi}
\newcommand{\IAbstractPage}{\ifIAbstractPage\input{\StyleDir/pages/abstractpage}\fi}
\newcommand{\IStatementPage}{\ifIStatement\input{\StyleDir/pages/statement}\fi}
\newcommand{\IMainMatter}{\clearpage\pagenumbering{arabic}}

